Window.SetBackgroundTopColor (0.047, 0.078, 0.125);
Window.SetBackgroundBottomColor (0.090, 0.145, 0.215);
logo_image = Image("yfit-mark.png");
logo = Sprite(logo_image);
logo.SetX(Window.GetWidth() / 2 - logo_image.GetWidth() / 2);
logo.SetY(Window.GetHeight() / 2 - logo_image.GetHeight() / 2 - 40);
status = Image.Text("Starting Yfit OS", 1.0, 0.76, 0.20);
status_sprite = Sprite(status);
status_sprite.SetX(Window.GetWidth() / 2 - status.GetWidth() / 2);
status_sprite.SetY(Window.GetHeight() / 2 + 100);
frame = 0;
fun refresh_callback () {
    frame = frame + 1;
    opacity = 0.72 + ((frame % 20) / 20.0) * 0.28;
    logo.SetOpacity(opacity);
}
Plymouth.SetRefreshFunction(refresh_callback);
