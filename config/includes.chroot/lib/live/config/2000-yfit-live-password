#!/bin/sh
set -eu
id yfit >/dev/null 2>&1 || { echo 'Yfit live account was not created before password hook' >&2; exit 1; }
password=$(openssl rand -hex 24)
printf 'yfit:%s\n' "$password" | chpasswd
umask 077
printf '%s\n' "$password" > /run/yfit-live-admin-password
chown root:yfit /run/yfit-live-admin-password
chmod 0440 /run/yfit-live-admin-password
unset password
