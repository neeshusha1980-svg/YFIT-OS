#!/bin/sh
set -eu
SNAPSHOT=${YFIT_DEBIAN_SNAPSHOT:-20261101T000000Z}
case "$SNAPSHOT" in
  [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z) ;;
  *) echo "YFIT_DEBIAN_SNAPSHOT must be YYYYMMDDThhmmssZ" >&2; exit 2 ;;
esac
ARCHIVE="https://snapshot.debian.org/archive/debian/${SNAPSHOT}/"
SECURITY="https://snapshot.debian.org/archive/debian-security/${SNAPSHOT}/"
lb config noauto \
  --mode debian \
  --distribution trixie \
  --architectures amd64 \
  --binary-images iso-hybrid \
  --bootloaders 'grub-pc,grub-efi' \
  --archive-areas 'main contrib non-free non-free-firmware' \
  --debian-installer live \
  --debian-installer-gui true \
  --firmware-chroot true \
  --firmware-binary true \
  --apt-recommends true \
  --apt-options '-o Acquire::Check-Valid-Until=false' \
  --mirror-bootstrap "$ARCHIVE" \
  --mirror-chroot "$ARCHIVE" \
  --mirror-chroot-security "$SECURITY" \
  --mirror-debian-installer "$ARCHIVE" \
  --mirror-binary 'https://deb.debian.org/debian/' \
  --mirror-binary-security 'https://security.debian.org/debian-security/' \
  --iso-application 'Yfit OS' \
  --iso-publisher 'Yfit' \
  --iso-volume 'YFIT_OS_1_0_AMD64' \
  --image-name 'yfit-os' \
  --linux-flavours amd64 \
  --bootappend-live 'boot=live components username=yfit locales=en_US.UTF-8 keyboard-layouts=us quiet splash apparmor=1 security=apparmor' \
  --memtest none \
  --source false
